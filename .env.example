# Copy this file to .env and adjust:  cp .env.example .env
# run.py and seed_demo.py read .env automatically.

# Secret used to sign login session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# If left empty, a random key is created once and stored in instance/.secret_key.
SECRET_KEY=

# 0.0.0.0 = accept connections on every network interface (needed for LAN clients).
# Use 127.0.0.1 to allow only this computer.
HOST=0.0.0.0
PORT=5000

# SQLite database file (default: instance/helpdesk.db)
# DATABASE_URL=sqlite:////home/you/campus-lab-helpdesk/instance/helpdesk.db

# Socket.IO heartbeat in seconds: ping interval and how long to wait for the reply.
SOCKETIO_PING_INTERVAL=10
SOCKETIO_PING_TIMEOUT=10

# How long a login lasts, in hours.
SESSION_HOURS=8

# Only set to 1 if the app is served over HTTPS (cookies would not be sent over plain HTTP).
SESSION_COOKIE_SECURE=0

# Show the demonstration accounts on the login page (for the project demo only).
SHOW_DEMO_CREDENTIALS=1
